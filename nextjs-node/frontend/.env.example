# Your Forte project ID. Forte sets NEXT_PUBLIC_FORTE_PROJECT_ID on every website build; set it
# here only for local development.
NEXT_PUBLIC_FORTE_PROJECT_ID=

# The backend service URL. Locally this is `forte proxy`, which runs in front of the backend.
# In production, set it to your service's URL (e.g. https://<your-service>.tryforte.dev).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
