# Your Forte project ID. Forte sets VITE_FORTE_PROJECT_ID on every website build; set it here only
# for local development. Copy this file to .env.local and fill it in.
VITE_FORTE_PROJECT_ID=

# The backend service URL. Locally this is `forte proxy`, which runs in front of the backend.
# In production, set it to your service's URL (e.g. https://<your-service>.tryforte.dev).
VITE_BACKEND_URL=http://localhost:8080
